#!/bin/bash
function rsync_git_repo() {
  if [ -z "$1" ]; then
    echo "Usage: rsync_git_repo <user@host:destination_path>"
    return 1
  fi

  local current_dir=$(pwd)
  local repo_name=$(basename "$current_dir")
  local remote_dest="$1"

  # Check if the current directory is a Git repository
  if [ ! -d ".git" ]; then
    echo "Error: Not a Git repository. Aborting."
    return 1
  fi

  echo "Attempting to rsync '$repo_name' from '$current_dir' to '$remote_dest/$repo_name'"
  read -p "Are you sure you want to proceed? (yes/no) " -n 3 -r
  echo # Newline for better formatting

  if [[ $REPLY =~ ^(yes|Yes|YES)$ ]]; then
    echo "Starting rsync..."
    # Using -e "ssh" is often implicit if using Host from SSH config,
    # but explicitly stating it can sometimes help or be clearer.
    rsync -avz --exclude '.git/index.lock' "$current_dir/" "$remote_dest/$repo_name"
    echo "Rsync complete."
  else
    echo "Rsync aborted."
  fi
}

function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  command yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd <"$tmp"
  [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
  command rm -f -- "$tmp"
}

function find_package_manager() {
  declare -A os_packagers=(
    [apt - get]="Debian/Ubuntu"
    [dnf]="Fedora/RHEL"
    [yum]="CentOS/RHEL"
    [pacman]="Arch Linux"
    [apk]="Alpine"
    [zypper]="openSUSE"
  )

  PACKAGE_MANAGER=""

  for mgr in "${!os_packagers[@]}"; do
    if command -v "$mgr" &>/dev/null; then
      PACKAGE_MANAGER="$mgr"
      break
    fi
  done

  if [ -n "$PACKAGE_MANAGER" ]; then
    echo PACKAGE_MANAGER
  else
    echo "Error: Supported package manager not found." >&2
    exit 1
  fi
}

function setup_new() {
  package_manager=$(find_package_manager)
  if [[ "$package_manager" == "dnf" ]]; then
    # Essentials
    sudo dnf install zoxide
    sudo dnf install bat
    sudo dnf install eza
    sudo dnf install fzf

    # Extra
    sudo dnf install lazygit
    sudo dnf install fastfetch
  fi
  #TODO: lazydoro code the other package managers

  # starship
  curl -sS https://starship.rs/install.sh | sh

  # mise
  curl https://mise.run | sh
  mise doctor
}
